      \__tkzpt_gset:nnn { esty }  { 0 } { }
      \__tkzpt_gset:nnn { pos }   { 0 } { }
      \__tkzpt_gset:nnn { hl }    { 0 } { 0 }
      \__tkzpt_gset:nnn { hn }    { 0 } { 0 }
      \__tkzpt_gset:nnn { alias } { 0 } { }
      \clist_gclear_new:c { g__tkzpt_ch_0_clist }
      %% lecture du corps (dans une boite pour neutraliser les espaces)
      \hbox_set:Nn \l__tkzpt_box {#2}
      \__tkzpt_layout:
      \__tkzpt_draw:
    \group_end:
