      \int_gzero:N \g__tkzpt_n_int
      \int_set:Nn \l__tkzpt_cur_int { 0 }
      %% racine
      \__tkzpt_gset:nnn { par }   { 0 } { 0 }
      \__tkzpt_gset:nnn { dep }   { 0 } { 0 }
      \__tkzpt_gset:nnn { path }  { 0 } { 0 }
      \__tkzpt_gset:nnV { lab }   { 0 } \l__tkzpt_root_tl
      \__tkzpt_gset:nnn { p }     { 0 } { }
      \__tkzpt_gset:nnn { psym }  { 0 } { }
      \__tkzpt_gset:nnn { v }     { 0 } { }
