%------------------------------------------------------------------
% ProfLycee.sty = point d'entree "tout inclus", historique.
% Toute la logique (options, langues, paquets, chargement des
% modules tools-*.tex) vit desormais dans ProfLycee-Light.sty, qui
% est le SEUL fichier a maintenir pour ces aspects communs.
% Les options passees a \usepackage{ProfLycee} (ex: [nonsiunitxfr],
% [warningsoff], [fa6], [english]...) sont transmises telles quelles
% a ProfLycee-Light, qui les declare a l'identique.
%------------------------------------------------------------------
\RequirePackageWithOptions{ProfLycee-Light}

% Comportement par defaut inchange depuis les versions precedentes :
