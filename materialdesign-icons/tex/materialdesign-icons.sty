%====int macros
\newcommand{\materialdesignfilled}[2][height=\materialdesignDefaultHeight]{%
  \csname materialdesignfilled #2\endcsname{#1}%
}%

\newcommand{\materialdesignoutlined}[2][height=\materialdesignDefaultHeight]{%
  \csname materialdesignoutlined #2\endcsname{#1}%
}%

\newcommand{\materialdesignround}[2][height=\materialdesignDefaultHeight]{%
  \csname materialdesignround #2\endcsname{#1}%
}%

\newcommand{\materialdesignsharp}[2][height=\materialdesignDefaultHeight]{%
  \csname materialdesignsharp #2\endcsname{#1}%
}%

\newcommand{\materialdesigntwotone}[2][height=\materialdesignDefaultHeight]{%
  \csname materialdesigntwotone #2\endcsname{#1}%
}%

%====main macro
\defKV[materialdesign]{height=\def\materialdesignheigth{#1},strut=\def\materialdesigntrut{#1},dstrut=\def\materialdesigndstrut{#1}}

\setKVdefault[materialdesign]{height=dauto,filled=true,outlined=false,round=false,sharp=false,twotone=false,strut={X},dstrut={qX}}

\NewDocumentCommand\materialdesignicon{O{}D<>{}m}{%
  \restoreKV[materialdesign]%
  \setKV[materialdesign]{#1}%
  \ifboolKV[materialdesign]{outlined}{\setKV[materialdesign]{filled=false}}{}%
  \ifboolKV[materialdesign]{round}{\setKV[materialdesign]{filled=false}}{}%
  \ifboolKV[materialdesign]{sharp}{\setKV[materialdesign]{filled=false}}{}%
  \ifboolKV[materialdesign]{twotone}{\setKV[materialdesign]{filled=false}}{}%
  \ifthenelse{\equal{\materialdesignheigth}{auto}}%
    {%
      \settoheight\materialdesignDefaultHeight{\hbox{\materialdesigntrut}}%height of \materialdesigntrut
      \ifboolKV[materialdesign]{filled}
        {%
          \materialdesignfilled[height=\materialdesignDefaultHeight,#2]{#3}%
        }%
        {}%
      \ifboolKV[materialdesign]{outlined}
        {%
          \materialdesignoutlined[height=\materialdesignDefaultHeight,#2]{#3}%
        }%
        {}%
      \ifboolKV[materialdesign]{round}
        {%
          \materialdesignround[height=\materialdesignDefaultHeight,#2]{#3}%
        }%
        {}%
      \ifboolKV[materialdesign]{sharp}
        {%
          \materialdesignsharp[height=\materialdesignDefaultHeight,#2]{#3}%
        }%
        {}%
      \ifboolKV[materialdesign]{twotone}
        {%
          \materialdesigntwotone[height=\materialdesignDefaultHeight,#2]{#3}%
        }%
        {}%
    }%
    {%
      \ifthenelse{\equal{\materialdesignheigth}{dauto}}%
        {%
          \settototalheight\materialdesignDefaultTotalHeight{\hbox{\materialdesigndstrut}}%height of \materialdesigndstrut
          \settodepth\materialdesignDefaultDepth{\hbox{\materialdesigndstrut}}%depth of \materialdesigndstrut
          \ifboolKV[materialdesign]{filled}
            {%
              \raisebox{-\materialdesignDefaultDepth}{%
                \materialdesignfilled[height=\materialdesignDefaultTotalHeight,#2]{#3}%
              }%
            }%
            {}%
          \ifboolKV[materialdesign]{outlined}
            {%
              \raisebox{-\materialdesignDefaultDepth}{%
                \materialdesignoutlined[height=\materialdesignDefaultTotalHeight,#2]{#3}%
              }%
            }%
            {}%
          \ifboolKV[materialdesign]{round}
            {%
              \raisebox{-\materialdesignDefaultDepth}{%
                \materialdesignround[height=\materialdesignDefaultTotalHeight,#2]{#3}%
              }%
            }%
            {}%
          \ifboolKV[materialdesign]{sharp}
            {%
              \raisebox{-\materialdesignDefaultDepth}{%
                \materialdesignsharp[height=\materialdesignDefaultTotalHeight,#2]{#3}%
              }%
            }%
            {}%
          \ifboolKV[materialdesign]{twotone}
            {%
              \raisebox{-\materialdesignDefaultDepth}{%
                \materialdesigntwotone[height=\materialdesignDefaultTotalHeight,#2]{#3}%
              }%
            }%
            {}%
        }%
        {%
          \IfSubStr{\materialdesignheigth}{/}%
            {%
              \StrCut*{\materialdesignheigth}{/}{\materialdesignmanualheight}{\materialdesignmanualdepth}%
              \setlength\materialdesignNormalHeight{\materialdesignmanualheight}%
              \setlength\materialdesignDefaultDepth{\materialdesignmanualdepth}%
              \ifboolKV[materialdesign]{filled}%
                {%
                  \raisebox{\materialdesignDefaultDepth}{%
                    \materialdesignfilled[height=\materialdesignNormalHeight,#2]{#3}%
                  }%
                }%
                {}%
              \ifboolKV[materialdesign]{outlined}%
                {%
                  \raisebox{\materialdesignDefaultDepth}{%
                    \materialdesignoutlined[height=\materialdesignNormalHeight,#2]{#3}%
                  }%
                }%
                {}%
              \ifboolKV[materialdesign]{round}%
                {%
                  \raisebox{\materialdesignDefaultDepth}{%
                    \materialdesignround[height=\materialdesignNormalHeight,#2]{#3}%
                  }%
                }%
                {}%
              \ifboolKV[materialdesign]{sharp}%
                {%
                  \raisebox{\materialdesignDefaultDepth}{%
                    \materialdesignsharp[height=\materialdesignNormalHeight,#2]{#3}%
                  }%
                }%
                {}%
              \ifboolKV[materialdesign]{twotone}%
                {%
                  \raisebox{\materialdesignDefaultDepth}{%
                    \materialdesigntwotone[height=\materialdesignNormalHeight,#2]{#3}%
                  }%
                }%
                {}%
            }%
            {%
              \setlength\materialdesignNormalHeight{\materialdesignheigth}%
              \ifboolKV[materialdesign]{filled}%
                {%
                  \materialdesignfilled[height=\materialdesignNormalHeight,#2]{#3}%
                }%
                {}%
              \ifboolKV[materialdesign]{outlined}%
                {%
                  \materialdesignoutlined[height=\materialdesignNormalHeight,#2]{#3}%
                }%
                {}%
              \ifboolKV[materialdesign]{round}%
                {%
                  \materialdesignround[height=\materialdesignNormalHeight,#2]{#3}%
                }%
                {}%
              \ifboolKV[materialdesign]{sharp}%
                {%
                  \materialdesignsharp[height=\materialdesignNormalHeight,#2]{#3}%
                }%
                {}%
              \ifboolKV[materialdesign]{twotone}%
                {%
                  \materialdesigntwotone[height=\materialdesignNormalHeight,#2]{#3}%
                }%
                {}%
            }%
        }%
    }%
}

