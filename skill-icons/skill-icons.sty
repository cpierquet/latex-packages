%====history
% 0.1a : initial version

%====packages
\RequirePackage{graphicx}

%====options (default theme)
\newcommand*{\skilliconsdefaulttheme}{dark}
\DeclareOption{dark}{\renewcommand*{\skilliconsdefaulttheme}{dark}}
\DeclareOption{light}{\renewcommand*{\skilliconsdefaulttheme}{light}}
\ProcessOptions\relax

%====suppress warnings
\begingroup\expandafter\expandafter\expandafter\endgroup
\expandafter\ifx\csname pdfsuppresswarningpagegroup\endcsname\relax
\else
  \pdfsuppresswarningpagegroup=1\relax
\fi

\ExplSyntaxOn

%====variables
\tl_new:N   \l__skillicon_page_tl
\tl_new:N   \l__skillicon_height_tl
\tl_new:N   \l__skillicon_strut_tl
\tl_new:N   \l__skillicon_dstrut_tl
\tl_new:N   \l__skillicon_theme_tl
\tl_new:N   \g__skillicon_theme_tl
\tl_new:N   \l__skillicon_file_tl
\dim_new:N  \l__skillicon_height_dim
\dim_new:N  \l__skillicon_depth_dim
\box_new:N  \l__skillicon_box
\seq_new:N  \l__skillicon_seq

%====default theme (package option, can be changed with \skilliconssetup)
\tl_gset:NV \g__skillicon_theme_tl \skilliconsdefaulttheme
\cs_undefine:N \skilliconsdefaulttheme

%====keys
\keys_define:nn { skillicon }
  {
    height .tl_set:N  = \l__skillicon_height_tl ,
    height .initial:n = dauto ,
    strut  .tl_set:N  = \l__skillicon_strut_tl ,
    strut  .initial:n = X ,
    dstrut .tl_set:N  = \l__skillicon_dstrut_tl ,
    dstrut .initial:n = qX ,
    theme  .choices:nn = { dark , light }
      { \tl_set_eq:NN \l__skillicon_theme_tl \l_keys_choice_tl } ,
  }

\keys_define:nn { skillicon-setup }
  {
    theme  .choices:nn = { dark , light }
      { \tl_gset_eq:NN \g__skillicon_theme_tl \l_keys_choice_tl } ,
  }

%====messages
\msg_new:nnn { skill-icons } { unknown-icon }
  { Unknown~icon~'#1'. }

%====icon registration : page number in skill-icons-dark-all.pdf and skill-icons-light-all.pdf
\NewDocumentCommand \GenerateSkillIcons { m m }
  { \cs_gset_nopar:cpn { __skillicon_page_ #2 } {#1} }

%====default theme for the whole document : \skilliconssetup{theme=light}
\NewDocumentCommand \skilliconssetup { m }
  { \keys_set:nn { skillicon-setup } {#1} }

%====includegraphics call (#1 = height, #2 = extra keys)
\cs_new_protected:Npn \__skillicon_include:nn #1#2
  {
    \includegraphics
      [ page = \l__skillicon_page_tl , height = #1 , #2 ]
      { \l__skillicon_file_tl }
  }

%====main macro
\cs_new_protected:Npn \__skillicon_typeset:n #1
  {
    \str_if_eq:VnTF \l__skillicon_height_tl { auto }
      {
        % height of the strut
        \hbox_set:Nn \l__skillicon_box { \l__skillicon_strut_tl }
        \dim_set:Nn \l__skillicon_height_dim { \box_ht:N \l__skillicon_box }
        \__skillicon_include:nn { \l__skillicon_height_dim } {#1}
      }
      {
        \str_if_eq:VnTF \l__skillicon_height_tl { dauto }
          {
            % total height and depth of the dstrut
            \hbox_set:Nn \l__skillicon_box { \l__skillicon_dstrut_tl }
            \dim_set:Nn \l__skillicon_depth_dim { \box_dp:N \l__skillicon_box }
            \dim_set:Nn \l__skillicon_height_dim
              { \box_ht:N \l__skillicon_box + \box_dp:N \l__skillicon_box }
            \raisebox { - \l__skillicon_depth_dim }
              { \__skillicon_include:nn { \l__skillicon_height_dim } {#1} }
          }
          {
            \seq_set_split:NnV \l__skillicon_seq { / } \l__skillicon_height_tl
            \int_compare:nNnTF { \seq_count:N \l__skillicon_seq } > { 1 }
              {
                % height/depth given manually
                \dim_set:Nn \l__skillicon_height_dim { \seq_item:Nn \l__skillicon_seq { 1 } }
                \dim_set:Nn \l__skillicon_depth_dim  { \seq_item:Nn \l__skillicon_seq { 2 } }
                \raisebox { \l__skillicon_depth_dim }
                  { \__skillicon_include:nn { \l__skillicon_height_dim } {#1} }
              }
              {
                \dim_set:Nn \l__skillicon_height_dim { \l__skillicon_height_tl }
                \__skillicon_include:nn { \l__skillicon_height_dim } {#1}
              }
          }
      }
  }

\NewDocumentCommand \skillicons { O{} D<>{} m }
  {
    \group_begin:
      \tl_set_eq:NN \l__skillicon_theme_tl \g__skillicon_theme_tl
      \keys_set:nn { skillicon } {#1}
      \cs_if_exist:cTF { __skillicon_page_ #3 }
        {
          \tl_set_eq:Nc \l__skillicon_page_tl { __skillicon_page_ #3 }
          \tl_set:Nx \l__skillicon_file_tl { skill-icons- \l__skillicon_theme_tl -all.pdf }
          \__skillicon_typeset:n {#2}
        }
        { \msg_error:nnn { skill-icons } { unknown-icon } {#3} }
    \group_end:
  }

\ExplSyntaxOff

