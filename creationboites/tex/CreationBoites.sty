        {\textcolor{cbhlbcoul#1}{#2}}%
    }%
}

\newcommand\cbhlbgensoustitre[1]{%
  \intcbtestsubstr{#1}{§}%
    {%
      \intcbafterchar{#1}{§}[\cbhlbsstmp]%
      {~~\cbhlbpolicesoustitre\vphantom{\cbhlbstrut}\cbhlbsstmp}%
    }%
    {%
      \@ifundefined{cbhlbsstitre#1}%
        {~~{\cbhlbpolicesoustitre\vphantom{\cbhlbstrut}\cbhlbtextcoul{#1}{#1}}}%
        {~~{\cbhlbpolicesoustitre\vphantom{\cbhlbstrut}%
            \cbhlbtextcoul{#1}{\csname cbhlbsstitre#1\endcsname}}}%
    }%
}

\newcommand\paramsexocbhlb[1]{%
  \ifthenelse{\equal{#1}{}}%
    {%valeurs par défaut
      \setKVdefault[paramcbhlb]{%
        eptrait        = 0.375mm,%
        police num     = \Large\bfseries\sffamily,%
        police sstitre = \footnotesize\bfseries\sffamily,%
        police niveau  = \scriptsize\bfseries\sffamily,%
        label exo      = {},%
        apres num      = {},%
        compteur       = cbhlb,%
        couleurs       = true,%
        couleur auto   = false
      }
    }%
    {%nouvelles valeurs par défaut
      \setKVdefault[paramcbhlb]{#1}%
    }%
  \restoreKV[paramcbhlb]%
}

\newcommand\cbhlbinttitre[4]{%
  {\cbhlbpolicetitre\vphantom{\cbhlbstrut}\textcolor{#1}{\cbhlblabelexo\arabic{\cbhlbcount}\cbhlbsuitelabelexo}}%label + numéro
  {\cbhlbgensoustitre{#4}}%sous-titre/thème
  \hfill{}%
  {\cbhlbpoliceniveau\vphantom{\cbhlbstrut}\textcolor{cbhlbsoustitre}{#2}\enspace\textcolor{#1}{#3}}%niveau
}
\newcommand\cbhlbgentitre[2][1]{%
  %#1 = niveau
  %#2 = sous-titre
  \stepcounter{\cbhlbcount}%
  \ifnum#1=0\relax\cbhlbinttitre{cbhlbcoulcours}{\cbhlblabelnivA}{\cbhlbnivA}{#2}\fi%
  \ifnum#1=1\relax\cbhlbinttitre{cbhlbcoulfacile}{\cbhlblabelnivB}{\cbhlbnivB}{#2}\fi%
  \ifnum#1=2\relax\cbhlbinttitre{cbhlbcoulmoyen}{\cbhlblabelnivC}{\cbhlbnivC}{#2}\fi%
  \ifnum#1=3\relax\cbhlbinttitre{cbhlbcouldifficile}{\cbhlblabelnivD}{\cbhlbnivD}{#2}\fi%
  \ifnum#1=4\relax\cbhlbinttitre{cbhlbcoulexpert}{\cbhlblabelnivE}{\cbhlbnivE}{#2}\fi%
  %
  \ifnum#1=0\relax\textcolor{cbhlbcoulcours}{\hrule height \lhbrtwidthrule}\fi%
  \ifnum#1=1\relax\textcolor{cbhlbcoulfacile}{\hrule height \lhbrtwidthrule}\fi%
  \ifnum#1=2\relax\textcolor{cbhlbcoulmoyen}{\hrule height \lhbrtwidthrule}\fi%
  \ifnum#1=3\relax\textcolor{cbhlbcouldifficile}{\hrule height \lhbrtwidthrule}\fi%
  \ifnum#1=4\relax\textcolor{cbhlbcoulexpert}{\hrule height \lhbrtwidthrule}\fi%
  %
  \medskip
}

