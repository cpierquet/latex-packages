%====GÉNÉRATEUR DE TITRE BICOLORE (sans sous-titre, géré par after title)
\newcommand\cbgendalttitre[6]{%
  % #1=couleur #2=nom #3=compteur #4=sing #5=plur #6=before
  \ifboolKV[cpaltboites]{SouligneLabel}%
    {\renewcommand\ULthickness{\cbulinethick}\settodepth\ULdepth{\hbox{pqyj}}}%
    {}%
  \ifboolKV[cpaltboites]{Compteur}%
  {%
    \ifboolKV[cpaltboites]{SouligneLabel}%
    {%
      \textcolor{white}{\policetitreboite{#6}%
        \intcbteststreq{\cbpersonalcpt}{}%
          {{\uline{\stepcounter{#3}{\vphantom{(qPÉ)}\tmplabelboite\cpaltboitescplttitre~\arabic{#3}}}}}%
          {{\uline{\stepcounter{\cbpersonalcpt}{\vphantom{(qPÉ)}\tmplabelboite\cpaltboitescplttitre~\arabic{\cbpersonalcpt}}}}}}%
    }%
    {%
      \textcolor{white}{\policetitreboite%
        \intcbteststreq{\cbpersonalcpt}{}%
          {\stepcounter{#3}\vphantom{(qPÉ)}{#6}\tmplabelboite\cpaltboitescplttitre~\arabic{#3}}%
          {\stepcounter{\cbpersonalcpt}\vphantom{(qPÉ)}{#6}\tmplabelboite\cpaltboitescplttitre~\arabic{\cbpersonalcpt}}}%
    }%
  }%
  {%
    \textcolor{white}{\policetitreboite\vphantom{(qPÉ)}{#6}\tmplabelboite\cpaltboitescplttitre}%
  }%
}

