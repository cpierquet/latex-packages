%====variables
\tl_new:N   \l__gameicon_page_tl
\tl_new:N   \l__gameicon_height_tl
\tl_new:N   \l__gameicon_strut_tl
\tl_new:N   \l__gameicon_dstrut_tl
\dim_new:N  \l__gameicon_height_dim
\dim_new:N  \l__gameicon_depth_dim
\tl_new:N   \l__gameicon_file_tl
\tl_set:Nn \l__gameicon_file_tl { gameicons-all.pdf }
\tl_new:N   \l__gameicon_badge_tl
\tl_new:N   \l__gameicon_badgepos_tl
\tl_new:N   \l__gameicon_badgescale_tl
\tl_new:N   \l__gameicon_badgecolor_tl
\dim_new:N  \l__gameicon_badge_dim
\dim_new:N  \l__gameicon_dx_dim
\dim_new:N  \l__gameicon_dy_dim
\box_new:N  \l__gameicon_box
\box_new:N  \l__gameicon_ibox
\box_new:N  \l__gameicon_bbox
\seq_new:N  \l__gameicon_seq

%====keys
\keys_define:nn { gameicon }
  {
    height .tl_set:N  = \l__gameicon_height_tl ,
    height .initial:n = dauto ,
    strut  .tl_set:N  = \l__gameicon_strut_tl ,
    strut  .initial:n = X ,
    dstrut .tl_set:N  = \l__gameicon_dstrut_tl ,
    dstrut .initial:n = qX ,
    badge       .tl_set:N  = \l__gameicon_badge_tl ,
    badge       .initial:n = ,
    badgepos    .tl_set:N  = \l__gameicon_badgepos_tl ,
    badgepos    .initial:n = br ,
    badgescale  .tl_set:N  = \l__gameicon_badgescale_tl ,
    badgescale  .initial:n = 0.4 ,
    badgecolor  .tl_set:N  = \l__gameicon_badgecolor_tl ,
    badgecolor  .initial:n = ,
  }

%====messages
\msg_new:nnn { game-icons } { unknown-icon }
  { Unknown~icon~'#1'. }
\msg_new:nnn { game-icons } { unknown-badge }
  { Unknown~badge~'#1'. }
\msg_new:nnn { game-icons } { unknown-badgepos }
  { Unknown~badge~position~'#1'~(use~tl,~tr,~bl,~br~or~c). }
\msg_new:nnn { game-icons } { no-color }
  { The~key~'badgecolor'~needs~the~xcolor~(or~color)~package. }

%====icon registration : page number in gameicons-all.pdf
\NewDocumentCommand \GenerateGameIcons { m m }
  { \cs_gset_nopar:cpn { __gameicon_page_ #2 } {#1} }

%====badge registration : page number in gameicons-badges-all.pdf
\NewDocumentCommand \GenerateGameIconsBadge { m m }
  { \cs_gset_nopar:cpn { __gameicon_badge_page_ #2 } {#1} }

%====includegraphics call of the icon alone (#1 = height, #2 = extra keys)
\cs_new_protected:Npn \__gameicon_icon:nn #1#2
  {
    \includegraphics
      [ page = \l__gameicon_page_tl , height = #1 , #2 ]
      { \l__gameicon_file_tl }
  }

%====badge (square) of height \l__gameicon_badge_dim
\cs_new_protected:Npn \__gameicon_badge_box:
  {
    \hbox_set:Nn \l__gameicon_bbox
      {
        \tl_if_empty:NF \l__gameicon_badgecolor_tl
          {
            \cs_if_exist:NTF \color
              { \exp_args:NV \color \l__gameicon_badgecolor_tl }
              { \msg_warning:nn { game-icons } { no-color } }
          }
        \includegraphics
          [ page = \tl_use:c { __gameicon_badge_page_ \l__gameicon_badge_tl } , height = \l__gameicon_badge_dim ]
          { gameicons-badges-all.pdf }
      }
  }

%====includegraphics call (#1 = height, #2 = extra keys) : icon, with an optional badge
\cs_new_protected:Npn \__gameicon_include:nn #1#2
  {
    \tl_if_empty:NTF \l__gameicon_badge_tl
      { \__gameicon_icon:nn {#1} {#2} }
      {
        \cs_if_exist:cTF { __gameicon_badge_page_ \l__gameicon_badge_tl }
          {
            \hbox_set:Nn \l__gameicon_ibox { \__gameicon_icon:nn {#1} {#2} }
            \dim_set:Nn \l__gameicon_badge_dim { \box_ht:N \l__gameicon_ibox + \box_dp:N \l__gameicon_ibox }
            \dim_set:Nn \l__gameicon_badge_dim { \l__gameicon_badgescale_tl \l__gameicon_badge_dim }
            \dim_set:Nn \l__gameicon_dx_dim { 0pt }
            \dim_set:Nn \l__gameicon_dy_dim { 0pt }
            \str_case:VnF \l__gameicon_badgepos_tl
              {
                { bl } { }
                { c }
                  {
                    \dim_set:Nn \l__gameicon_dx_dim { ( \box_wd:N \l__gameicon_ibox - \l__gameicon_badge_dim ) / 2 }
                    \dim_set:Nn \l__gameicon_dy_dim { ( \box_ht:N \l__gameicon_ibox + \box_dp:N \l__gameicon_ibox - \l__gameicon_badge_dim ) / 2 }
                  }
                { br } { \dim_set:Nn \l__gameicon_dx_dim { \box_wd:N \l__gameicon_ibox - \l__gameicon_badge_dim } }
                { tl } { \dim_set:Nn \l__gameicon_dy_dim { \box_ht:N \l__gameicon_ibox + \box_dp:N \l__gameicon_ibox - \l__gameicon_badge_dim } }
                { tr }
                  {
                    \dim_set:Nn \l__gameicon_dx_dim { \box_wd:N \l__gameicon_ibox - \l__gameicon_badge_dim }
                    \dim_set:Nn \l__gameicon_dy_dim { \box_ht:N \l__gameicon_ibox + \box_dp:N \l__gameicon_ibox - \l__gameicon_badge_dim }
                  }
              }
              { \msg_error:nnV { game-icons } { unknown-badgepos } \l__gameicon_badgepos_tl }
            \__gameicon_badge_box:
            \hbox_set:Nn \l__gameicon_bbox
              { \box_move_up:nn { \l__gameicon_dy_dim } { \box_use:N \l__gameicon_bbox } }
            \box_use:N \l__gameicon_ibox
            \skip_horizontal:n { - \box_wd:N \l__gameicon_ibox }
            \hbox_to_wd:nn { \box_wd:N \l__gameicon_ibox }
              { \skip_horizontal:n { \l__gameicon_dx_dim } \box_use:N \l__gameicon_bbox \hfil }
          }
          {
            \msg_error:nnV { game-icons } { unknown-badge } \l__gameicon_badge_tl
            \__gameicon_icon:nn {#1} {#2}
          }
      }
  }

%====main macro
\cs_new_protected:Npn \__gameicon_typeset:n #1
  {
    \str_if_eq:VnTF \l__gameicon_height_tl { auto }
      {
        % height of the strut
        \hbox_set:Nn \l__gameicon_box { \l__gameicon_strut_tl }
        \dim_set:Nn \l__gameicon_height_dim { \box_ht:N \l__gameicon_box }
        \__gameicon_include:nn { \l__gameicon_height_dim } {#1}
      }
      {
        \str_if_eq:VnTF \l__gameicon_height_tl { dauto }
          {
            % total height and depth of the dstrut
            \hbox_set:Nn \l__gameicon_box { \l__gameicon_dstrut_tl }
            \dim_set:Nn \l__gameicon_depth_dim { \box_dp:N \l__gameicon_box }
            \dim_set:Nn \l__gameicon_height_dim
              { \box_ht:N \l__gameicon_box + \box_dp:N \l__gameicon_box }
            \raisebox { - \l__gameicon_depth_dim }
              { \__gameicon_include:nn { \l__gameicon_height_dim } {#1} }
          }
          {
            \seq_set_split:NnV \l__gameicon_seq { / } \l__gameicon_height_tl
            \int_compare:nNnTF { \seq_count:N \l__gameicon_seq } > { 1 }
              {
                % height/depth given manually
                \dim_set:Nn \l__gameicon_height_dim { \seq_item:Nn \l__gameicon_seq { 1 } }
                \dim_set:Nn \l__gameicon_depth_dim  { \seq_item:Nn \l__gameicon_seq { 2 } }
                \raisebox { \l__gameicon_depth_dim }
                  { \__gameicon_include:nn { \l__gameicon_height_dim } {#1} }
              }
              {
                \dim_set:Nn \l__gameicon_height_dim { \l__gameicon_height_tl }
                \__gameicon_include:nn { \l__gameicon_height_dim } {#1}
              }
          }
      }
  }

\NewDocumentCommand \gameicons { O{} D<>{} m }
  {
    \group_begin:
      \keys_set:nn { gameicon } {#1}
      \cs_if_exist:cTF { __gameicon_page_ #3 }
        {
          \tl_set_eq:Nc \l__gameicon_page_tl { __gameicon_page_ #3 }
          \__gameicon_typeset:n {#2}
        }
        { \msg_error:nnn { game-icons } { unknown-icon } {#3} }
    \group_end:
  }

%====badge alone : \gameiconsbadge[height=...]<includegraphics options>{badge name}
\NewDocumentCommand \gameiconsbadge { O{} D<>{} m }
  {
    \group_begin:
      \keys_set:nn { gameicon } {#1}
      \tl_clear:N \l__gameicon_badge_tl
      \cs_if_exist:cTF { __gameicon_badge_page_ #3 }
        {
          \tl_set_eq:Nc \l__gameicon_page_tl { __gameicon_badge_page_ #3 }
          \tl_set:Nn \l__gameicon_file_tl { gameicons-badges-all.pdf }
          \__gameicon_typeset:n {#2}
        }
        { \msg_error:nnn { game-icons } { unknown-badge } {#3} }
    \group_end:
  }

